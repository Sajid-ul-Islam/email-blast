# Email Blast — configuration template
# Copy this file to .env and fill in the values.
# DO NOT commit .env — it is git-ignored.

# ---------------------------------------------------------------------------
# SMTP Settings (default: Gmail; change for cPanel / any custom SMTP)
# ---------------------------------------------------------------------------
SMTP_HOST=mail.deencommerce.com
SMTP_PORT=587
SMTP_USE_TLS=true

# ---------------------------------------------------------------------------
# Sender identity
# ---------------------------------------------------------------------------
GMAIL_USER=hello@deencommerce.com
GMAIL_APP_PASSWORD=<YOUR_MAILBOX_PASSWORD>
FROM_NAME=Deen Commerce

# ---------------------------------------------------------------------------
# Campaign defaults
# ---------------------------------------------------------------------------
EMAIL_LIST=emails.csv
DAILY_CAP=500

# CLI safety stop (send_emails.py --max-per-day): default 1950 leaves buffer
# under Google Workspace's 2000/day standard limit. --resume skips today's
# already-sent rows so the remainder can go out the next day.
MAX_PER_DAY=1950

# Retention: uploaded CSVs, content files, and job JSONs older than this many
# days are purged at startup and every 6 hours (they contain recipient PII).
RETENTION_DAYS=14

# ---------------------------------------------------------------------------
# Optional features
# ---------------------------------------------------------------------------

# Unsubscribe link appended to every email + List-Unsubscribe header.
# {{email}} is substituted URL-encoded. Recommended: use {{token}} so links
# are signed and cannot be forged for other addresses:
#   UNSUBSCRIBE_URL=http://127.0.0.1:5000/unsubscribe?email={{email}}&token={{token}}
# Recipients who confirm opt-out are recorded in SUPPRESSION_PATH and skipped
# by every future send.
UNSUBSCRIBE_URL=

# HMAC secret for signing unsubscribe {{token}}s (any long random string).
# If unset, a per-process random secret is used and links stop working after
# a restart -- set a fixed value in production.
UNSUBSCRIBE_SECRET=

# Suppression list file (one email per line; appended on opt-out).
SUPPRESSION_PATH=suppression.txt

# Webhook called with a JSON summary when a campaign finishes.
# Works with Slack incoming webhooks, Discord, Zapier, etc.
WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Web app access control (leave APP_PASSWORD blank to disable auth)
# With no APP_PASSWORD the app only binds to loopback; a non-loopback HOST is
# refused at startup so the send UI is never exposed unauthenticated.
# ---------------------------------------------------------------------------
APP_USERNAME=admin
APP_PASSWORD=

# Bind address / port for the web app (127.0.0.1 = local only).
HOST=127.0.0.1
PORT=5000

# Shared send log used for the cross-job, cross-restart daily cap (R-O6).
SENT_LOG_PATH=sent_log.csv

# Login rate limiting (only applies when APP_PASSWORD is set):
# after LOGIN_MAX_ATTEMPTS failures within LOGIN_WINDOW_SECONDS, that IP is
# locked out for LOGIN_LOCKOUT_SECONDS.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900

# Flask session secret key (auto-generated each restart if left blank)
SECRET_KEY=
